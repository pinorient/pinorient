# Comma-separated list of allowed domains. Supports wildcard prefixes like *.mysite.com.
# Leave empty to allow public access.
ALLOWED_DOMAINS=*.mysite.com

# URL to the OSM PBF extract to download and index.
OSM_DATA_URL=https://download.geofabrik.de/north-america/us-latest.osm.pbf

# Local directory where OSM data is stored (within the PocketBase data directory).
OSM_DATA_PATH=./pb_data/geo_data

# Cron expression for periodic OSM data refresh. Leave empty to disable.
# Example: every Sunday at 3 AM.
UPDATE_CRON=0 3 * * 0

# TIGER/Line address data for address interpolation (fills coverage gaps in OSM).
# Year of TIGER/Line data to download.
TIGER_YEAR=2025

# Comma-separated list of county FIPS codes to import.
# Example: 25017 = Middlesex County, MA (Cambridge area).
# Only used when TIGER_ALL_COUNTIES is false. Leave empty to import all US counties.
# TIGER_COUNTIES=25017

# Import TIGER/Line ADDRFEAT data for ALL US counties (~3,200 counties).
# This downloads ~50GB of data and may take several hours.
# Defaults to true. Set to false/0 to use TIGER_COUNTIES instead.
TIGER_ALL_COUNTIES=true

# Force re-import of TIGER/Line data on startup.
# TIGER_FORCE_REIMPORT=1

# SQLite performance tuning (adjust for server RAM)
# DB_CACHE_SIZE=65536      # Cache in KB (65536=64MB default, 262144=256MB for 8GB+ RAM servers)
# DB_MMAP_SIZE=0           # mmap in bytes (0=disabled default, 4294967296=4GB for 8GB+ RAM servers)

# Memory-safe import settings (important for 2GB RAM servers)
# Batch size for OSM and TIGER imports. Smaller = less memory, more DB writes.
# Default: 2000 (safe for 2GB RAM). Use 5000+ on 8GB+ RAM servers.
# IMPORT_BATCH_SIZE=2000

# Number of goroutines for OSM PBF decoder. Each worker uses extra memory.
# Default: 2 (safe for 2GB RAM). Set to 0 for runtime.NumCPU() (not recommended for low-RAM).
# OSM_DECODER_WORKERS=2

# Run OSM and TIGER imports sequentially instead of concurrently.
# Sequential mode halves peak memory usage at the cost of slightly longer wall time.
# Default: true (safe for 2GB RAM). Set to false on 8GB+ RAM servers for faster imports.
# SERIALIZE_IMPORTS=true

# Rows indexed per committed transaction when (re)building FTS5 search indexes.
# Chunked rebuilds keep WAL growth and peak memory bounded and resume from the
# last committed chunk after a crash. Default: 250000.
# FTS_REBUILD_CHUNK=250000

# Keep downloaded TIGER/Line ZIPs and extracted shapefiles after import.
# Default: false (delete after each county). The full US dataset is ~100GB
# unpacked, which does not fit on small VPS disks. Import progress is tracked
# in the database, so deleted counties are NOT re-imported.
# TIGER_KEEP_DATA=false

# Keep the downloaded OSM PBF extract after a successful import.
# Default: true (keep), so scheduled refreshes / FORCE_REINDEX don't re-download
# the multi-GB file. Set to false to reclaim the disk space after import.
# OSM_KEEP_DATA=true

# Way centroid resolution (gives every indexed way — buildings, POIs, streets —
# real coordinates instead of 0,0). Runs after each OSM import as three
# crash-resumable passes over the extract. Default: true.
# Requires ~6-8GB of temporary disk for the node-coordinate table (dropped
# after the phase completes) plus WAY_COORDS_BLOOM_MB of RAM during one pass.
# WAY_COORDS_ENABLED=true

# MiB of RAM for the bloom filter used to select way-referenced nodes.
# Default: 256 (false positives of a few percent for the US extract's ~500M
# node references). Minimum: 32 (too small for the US extract).
# WAY_COORDS_BLOOM_MB=256

# Go runtime heap cap. Imports get OOM-killed on 2GB servers without one.
# The app defaults to 1500MiB when neither variable is set.
# GOMEMLIMIT (standard Go syntax, e.g. 1800MiB) always wins when set.
# GOMEMLIMIT=1800MiB
# GO_MEM_LIMIT_MB=1500
